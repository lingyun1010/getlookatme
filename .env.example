OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_ONBOARDING_MODEL=gpt-5-mini
ONBOARDING_LLM_ENABLED=true
# Leave empty on Vercel so the browser uses the same deployment origin.
VITE_API_BASE_URL=
VITE_ONBOARDING_LLM_ENABLED=true
VITE_ONBOARDING_LLM_TIMEOUT_MS=60000
# Optional comma-separated extra origins for split local or preview deployments.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
