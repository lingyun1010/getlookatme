# Copy this file to .env.local for local development. Never commit populated env files.
APP_ENV=development

# Server/tooling only: OpenAI API access. Never expose this through VITE_*.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PR4 knowledge embeddings use 1536 dimensions; changing the model invalidates stored chunks.
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_ONBOARDING_MODEL=gpt-5-mini
ONBOARDING_LLM_ENABLED=true

# Browser-safe configuration. Every VITE_* value is bundled into browser code.
# Leave empty on Vercel so the browser uses the same deployment origin.
VITE_API_BASE_URL=
VITE_ONBOARDING_LLM_ENABLED=true
VITE_ONBOARDING_LLM_TIMEOUT_MS=60000
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Map the local CLI's Publishable key here. Never put its Secret key in VITE_*.
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Server/API configuration. SUPABASE_PUBLISHABLE_KEY is browser-safe but is used here
# to verify authenticated requests without relying on a VITE_* fallback.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# Map the local CLI's Secret key here. Current server/tooling code expects this name.
SUPABASE_SERVICE_ROLE_KEY=your-local-secret-key

# Used by the protected production/local HTTP worker endpoint.
CRON_SECRET=replace-with-a-local-random-value
# Optional local worker polling interval; minimum 1000ms, default 5000ms.
AVATAR_WORKER_POLL_MS=5000
# Optional comma-separated extra origins for split local or preview deployments.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Development only. The server also refuses mock billing in production environments.
MOCK_BILLING_ENABLED=true
# Browser-visible development flag for the mock upgrade UI only. Not a secret.
VITE_MOCK_BILLING_ENABLED=true
