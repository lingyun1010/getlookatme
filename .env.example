OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_ONBOARDING_MODEL=gpt-5-mini
ONBOARDING_LLM_ENABLED=true
# Leave empty on Vercel so the browser uses the same deployment origin.
VITE_API_BASE_URL=
VITE_ONBOARDING_LLM_ENABLED=true
VITE_ONBOARDING_LLM_TIMEOUT_MS=60000
VITE_SUPABASE_URL=
# Use the browser-safe publishable key. Never put a secret/service-role key in VITE_*.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side Auth token verification (same project and browser-safe publishable key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only worker credentials. Never expose these through VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional comma-separated extra origins for split local or preview deployments.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
