# Production values must be supplied by the deployment platform. This file contains placeholders only.
APP_ENV=production

# Browser-safe values. VITE_* variables are included in the client bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-production-publishable-key
# Leave empty when the API is served from the same deployment origin.
VITE_API_BASE_URL=
VITE_ONBOARDING_LLM_ENABLED=true
VITE_ONBOARDING_LLM_TIMEOUT_MS=60000

# Server-only runtime values. Never add a VITE_* prefix to these secrets.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-production-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-production-secret-or-service-role-key
OPENAI_API_KEY=your-production-openai-api-key
CRON_SECRET=your-production-cron-secret

# Server model and feature configuration.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_ONBOARDING_MODEL=gpt-5-mini
ONBOARDING_LLM_ENABLED=true
ALLOWED_ORIGINS=https://your-production-domain.example

# Used only if the standalone polling worker runs in the production environment.
AVATAR_WORKER_POLL_MS=5000

# Defense in depth: mock billing only runs when the resolved runtime is development.
MOCK_BILLING_ENABLED=false
VITE_MOCK_BILLING_ENABLED=false

# Stripe live/test keys must match the Stripe mode for this deployment. Never mix them.
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
APP_BASE_URL=https://your-production-domain.example
# Optional overrides:
# STRIPE_SUCCESS_URL=https://your-production-domain.example/dashboard/pricing?checkout=success
# STRIPE_CANCEL_URL=https://your-production-domain.example/dashboard/pricing?checkout=cancelled
