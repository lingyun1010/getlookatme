{
  "name": "lookatme-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/dev-api.ts",
    "dev:avatar-worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/dev-avatar-worker.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "rag:build": "node --env-file-if-exists=.env --experimental-strip-types scripts/build-rag-index.ts",
    "rag:test": "node --env-file-if-exists=.env --experimental-strip-types scripts/debug-rag.ts",
    "rag:regression": "node --env-file-if-exists=.env --experimental-strip-types scripts/regression-rag.ts",
    "knowledge:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/knowledge.ts sync",
    "knowledge:inspect": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/knowledge.ts inspect"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lookatme-avatar": "github:lingyun1010/lookatme-avatar",
    "mammoth": "^1.12.3",
    "openai": "^7.15.0",
    "pdfjs-dist": "^6.3.289",
    "stripe": "^18.5.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supabase": "^2.117.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
