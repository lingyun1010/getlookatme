{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/lingyun", "permanent": false }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/create", "destination": "/create.html" },
    { "source": "/edit", "destination": "/create.html" },
    { "source": "/dashboard", "destination": "/create.html" },
    { "source": "/:slug", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "{src/rag/**,src/profile/**,knowledge/lingyun.md,generated/rag-index.json}"
    }
  }
}
